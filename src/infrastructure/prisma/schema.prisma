// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// ===============================
/// ENUMS
/// ===============================

enum SsoProvider {
  GOOGLE
  APPLE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AgeRange {
  AGE_18_25
  AGE_26_35
  AGE_36_50
  AGE_51_64
  AGE_65_PLUS
}

enum TargetAudience {
  EVERYONE
  CHILDREN
  ADULTS
  SENIORS
}

enum ContentStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SourceType {
  CRAWLER
  COMMUNITY
  TEAM
}

enum SubmissionType {
  PLACE
  EVENT
}

enum Platform {
  ANDROID
  IOS
}

/// ===============================
/// USERS
/// ===============================

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  surnames String

  ssoProvider SsoProvider
  ssoSubject  String // stable user id returned by Google / Apple
  ageRange    AgeRange?
  role        UserRole  @default(USER)
  deletedAt   DateTime? // "Delete account" (App Store requirement)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests           UserInterest[]
  submissions         Submission[]   @relation("SubmissionAuthor")
  reviewedSubmissions Submission[]   @relation("SubmissionReviewer")
  favorites           Favorite[]
  reviews             Review[]
  devices             Device[]
  notifications       Notification[]

  @@unique([ssoProvider, ssoSubject])
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  interests UserInterest[]
  places    Place[]
  events    Event[]
}

model UserInterest {
  userId     String
  categoryId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
}

/// ===============================
/// GEOGRAPHY
/// ===============================

model Province {
  id      Int    @id // official INEC code
  name    String @unique
  cantons Canton[]
}

model Canton {
  id         Int    @id // official INEC code
  provinceId Int
  name       String

  province Province @relation(fields: [provinceId], references: [id])
  places   Place[]

  @@unique([provinceId, name])
}

/// ===============================
/// CONTENT CATALOG
/// ===============================

model Source {
  id            String     @id @default(uuid())
  name          String
  url           String?    @db.VarChar(2048)
  type          SourceType
  lastCrawledAt DateTime?

  places Place[]
  events Event[]
}

model Place {
  id          String  @id @default(uuid())
  cantonId    Int
  categoryId  Int
  sourceId    String?
  name        String
  description String? @db.Text

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  address   String?

  openingHours   Json?
  targetAudience TargetAudience @default(EVERYONE)
  status         ContentStatus  @default(PENDING)
  verifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canton    Canton     @relation(fields: [cantonId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  source    Source?    @relation(fields: [sourceId], references: [id])
  events    Event[]
  photos    Photo[]
  favorites Favorite[]
  reviews   Review[]

  @@index([cantonId, status])
  @@index([categoryId])
  @@index([latitude, longitude])
}

model Event {
  id          String  @id @default(uuid())
  placeId     String?
  categoryId  Int
  sourceId    String?
  title       String
  description String? @db.Text

  startsAt DateTime
  endsAt   DateTime?

  targetAudience TargetAudience @default(EVERYONE)
  status         ContentStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place         Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  category      Category       @relation(fields: [categoryId], references: [id])
  source        Source?        @relation(fields: [sourceId], references: [id])
  notifications Notification[]

  @@index([startsAt, status])
}

model Photo {
  id       String @id @default(uuid())
  placeId  String
  url      String @db.VarChar(2048)
  position Int    @default(0)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

/// ===============================
/// COMMUNITY & MODERATION
/// ===============================

model Submission {
  id     String         @id @default(uuid())
  userId String
  type   SubmissionType
  data   Json // raw suggestion, copied to Place/Event once approved

  status       ContentStatus @default(PENDING)
  aiScore      Float?
  aiReason     String?       @db.Text
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  author     User  @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Favorite {
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
}

model Review {
  id      String        @id @default(uuid())
  userId  String
  placeId String
  rating  Int // 1 to 5, validate in the API
  comment String?       @db.Text
  status  ContentStatus @default(PENDING)

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId]) // one review per user per place
}

/// ===============================
/// NOTIFICATIONS
/// ===============================

model Device {
  id        String   @id @default(uuid())
  userId    String
  platform  Platform
  pushToken String   @unique @db.VarChar(512)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  eventId String
  sentAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // never notify the same event twice
}
