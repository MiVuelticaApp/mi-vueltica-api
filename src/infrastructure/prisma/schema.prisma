// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// ===============================
/// ENUMS
/// ===============================

enum SsoProvider {
  GOOGLE
  APPLE
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AgeRange {
  AGE_18_25
  AGE_26_35
  AGE_36_50
  AGE_51_64
  AGE_65_PLUS
}

enum TargetAudience {
  EVERYONE
  CHILDREN
  ADULTS
  SENIORS
}

enum ContentStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SourceType {
  CRAWLER
  COMMUNITY
  TEAM
}

enum SubmissionType {
  PLACE
  EVENT
}

enum Platform {
  ANDROID
  IOS
}

/// Who the reviewer went with (app values: familia, amigos, pareja, solo).
enum ReviewCompanion {
  FAMILY
  FRIENDS
  PARTNER
  SOLO
}

/// "¿Sigue siendo gratis?" answer (app values: si, no, nose).
enum StillHappening {
  YES
  NO
  DONT_KNOW
}

/// Price the verifier paid (app values: gratis, menos2500, entre2500y5000, mas5000).
enum PricePaid {
  FREE
  UNDER_2500
  FROM_2500_TO_5000
  OVER_5000
}

/// Why a plan was reported (app values: cerro, noGratis, masDe5000, horario, inapropiado, spam, otro).
enum ReportReason {
  CLOSED
  NOT_FREE
  OVER_5000
  SCHEDULE
  INAPPROPRIATE
  SPAM
  OTHER
}

/// How much the reviewer spent (app values: nada, menos2500, entre2500y5000).
enum ReviewSpend {
  NOTHING
  UNDER_2500
  FROM_2500_TO_5000
}

/// ===============================
/// USERS
/// ===============================

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  surnames String

  ssoProvider SsoProvider
  ssoSubject  String // stable user id returned by Google / Apple
  ageRange    AgeRange?
  role        UserRole    @default(USER)
  deletedAt   DateTime? // "Delete account" (App Store requirement)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests           UserInterest[]
  submissions         Submission[]       @relation("SubmissionAuthor")
  reviewedSubmissions Submission[]       @relation("SubmissionReviewer")
  favorites           Favorite[]
  reviews             Review[]
  reviewUsefulVotes   ReviewUsefulVote[]
  authoredPlaces      Place[]            @relation("PlaceAuthor")
  authoredEvents      Event[]            @relation("EventAuthor")
  verifications       Verification[]
  reports             Report[]
  devices             Device[]
  notifications       Notification[]
  uploads             Upload[]

  @@unique([ssoProvider, ssoSubject])
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  interests UserInterest[]
  places    Place[]
  events    Event[]
}

model UserInterest {
  userId     String
  categoryId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
}

/// ===============================
/// GEOGRAPHY
/// ===============================

model Province {
  id      Int      @id // official INEC code
  name    String   @unique
  cantons Canton[]
}

model Canton {
  id         Int    @id // official INEC code
  provinceId Int
  name       String

  province Province @relation(fields: [provinceId], references: [id])
  places   Place[]

  @@unique([provinceId, name])
}

/// ===============================
/// CONTENT CATALOG
/// ===============================

model Source {
  id            String     @id @default(uuid())
  name          String
  url           String?    @db.VarChar(2048)
  type          SourceType
  lastCrawledAt DateTime?

  places Place[]
  events Event[]
}

model Place {
  id          String  @id @default(uuid())
  cantonId    Int
  categoryId  Int
  sourceId    String?
  name        String
  description String? @db.Text

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  address   String?

  openingHours   Json?
  targetAudience TargetAudience @default(EVERYONE)
  status         ContentStatus  @default(PENDING)
  verifiedAt     DateTime?

  // Community (#39). `authorId`: the user whose submission created it (NULL for team content or a
  // deleted account). A plan hidden by verifications/reports/moderation is ARCHIVED with `hiddenReason`;
  // `reportedAt` is set while it is hidden waiting for a moderator's decision on its reports.
  authorId     String?
  hiddenReason String?   @db.VarChar(191)
  reportedAt   DateTime?

  // Price and audience (issue #36). `pricePerPerson` is in colones, 0 = free, NULL = unknown;
  // values above 5000 are rejected by the domain. `targetAudience` is kept for older clients.
  pricePerPerson       Int?
  freeForStudents      Boolean @default(false)
  freeForSeniors       Boolean @default(false)
  audienceEveryone     Boolean @default(true)
  audienceFamilies     Boolean @default(false)
  audienceStudents     Boolean @default(false)
  audienceSeniors      Boolean @default(false)
  wheelchairAccessible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canton        Canton         @relation(fields: [cantonId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  source        Source?        @relation(fields: [sourceId], references: [id])
  author        User?          @relation("PlaceAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  events        Event[]
  photos        Photo[]
  favorites     Favorite[]
  reviews       Review[]
  verifications Verification[]
  reports       Report[]

  @@index([cantonId, status])
  @@index([categoryId])
  @@index([latitude, longitude])
  @@index([status, pricePerPerson])
}

model Event {
  id          String  @id @default(uuid())
  placeId     String?
  categoryId  Int
  sourceId    String?
  title       String
  description String? @db.Text

  startsAt DateTime
  endsAt   DateTime?

  targetAudience TargetAudience @default(EVERYONE)
  status         ContentStatus  @default(PENDING)

  // Community (#39), same as Place.
  authorId     String?
  hiddenReason String?   @db.VarChar(191)
  reportedAt   DateTime?

  // Price and audience (issue #36). `pricePerPerson` is in colones, 0 = free, NULL = unknown;
  // values above 5000 are rejected by the domain. `targetAudience` is kept for older clients.
  pricePerPerson       Int?
  freeForStudents      Boolean @default(false)
  freeForSeniors       Boolean @default(false)
  audienceEveryone     Boolean @default(true)
  audienceFamilies     Boolean @default(false)
  audienceStudents     Boolean @default(false)
  audienceSeniors      Boolean @default(false)
  wheelchairAccessible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place         Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)
  category      Category       @relation(fields: [categoryId], references: [id])
  source        Source?        @relation(fields: [sourceId], references: [id])
  author        User?          @relation("EventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  notifications Notification[]
  photos        Photo[]
  reviews       Review[]
  verifications Verification[]
  reports       Report[]

  @@index([startsAt, status])
}

/// Ordered gallery photo of exactly one Place or one Event (enforced by the application: MySQL 8
/// rejects a CHECK on columns with FK referential actions). `uploadId` is set when the file lives in our object storage (SeaweedFS, S3 API);
/// external https URLs added by moderators have no upload.
model Photo {
  id        String   @id @default(uuid())
  placeId   String?
  eventId   String?
  uploadId  String?
  url       String   @db.VarChar(2048)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  place  Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([placeId, position])
  @@index([eventId, position])
}

/// ===============================
/// FILES (S3-compatible object storage: SeaweedFS, proxied by the API)
/// ===============================

/// A file stored in the object storage under `objectKey` and served through GET /api/v1/files/:id.
/// It is kept while a Photo, a Submission, a Review, a Verification or a Report references it; unreferenced uploads older than
/// the grace period are removed by the cleanup job (object first, then the row).
model Upload {
  id          String   @id @default(uuid())
  userId      String?
  objectKey   String   @unique @db.VarChar(255)
  contentType String   @db.VarChar(100)
  size        Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  photos        Photo[]
  submissions   SubmissionUpload[]
  reviewPhotos  ReviewPhoto[]
  verifications Verification[]
  reports       Report[]

  @@index([createdAt])
}

/// Uploads attached to a submission (its `data.photos`). Keeps them alive until the
/// submission is deleted; on approval they are copied into the Place/Event gallery.
model SubmissionUpload {
  submissionId String
  uploadId     String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  upload     Upload     @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@id([submissionId, uploadId])
  @@index([uploadId])
}

/// ===============================
/// COMMUNITY & MODERATION
/// ===============================

model Submission {
  id     String         @id @default(uuid())
  userId String
  type   SubmissionType
  data   Json // raw suggestion, copied to Place/Event once approved

  status       ContentStatus @default(PENDING)
  aiScore      Float?
  aiReason     String?       @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?       @db.Text // moderator's reason when rejecting (aiReason is reserved for the AI job)

  createdAt DateTime @default(now())

  author     User               @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploads    SubmissionUpload[]

  @@index([status, createdAt])
}

model Favorite {
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
}

/// A rating of exactly one Place or one Event (enforced by the application, like Photo: MySQL 8
/// rejects a CHECK on columns with FK referential actions). `userId` becomes NULL when the author
/// deletes their account: the review is kept and shown as "Anónimo".
model Review {
  id       String           @id @default(uuid())
  userId   String?
  placeId  String?
  eventId  String?
  rating   Int // 1 to 5, validate in the API
  comment  String?          @db.Text
  wentWith ReviewCompanion?
  spent    ReviewSpend?
  status   ContentStatus    @default(PENDING)

  createdAt DateTime @default(now())

  // Deleting an account deletes its reviews (the app's rule; their photos are released to the orphan cleanup).
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  place       Place?             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos      ReviewPhoto[]
  usefulVotes ReviewUsefulVote[]

  @@unique([userId, placeId]) // one review per user per place
  @@unique([userId, eventId]) // one review per user per event
  @@index([placeId, status])
  @@index([eventId, status])
}

/// Photos attached by the author of a review (their own uploads). Keeps the uploads alive
/// until the review is deleted.
model ReviewPhoto {
  reviewId String
  uploadId String
  url      String @db.VarChar(2048)
  position Int

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@id([reviewId, uploadId])
  @@index([uploadId])
}

/// "¿Sigue siendo gratis?" answer about exactly one Place or one Event (enforced by the application).
/// One per person and plan (`personKey` = "user:<id>" or "device:<id>" for guests): a newer answer
/// replaces the previous one. Rows with `consumedAt` already produced an outcome (price update or
/// hiding) and no longer count towards the next one, but still count as verifications.
model Verification {
  id              String         @id @default(uuid())
  placeId         String?
  eventId         String?
  userId          String?
  personKey       String         @db.VarChar(160)
  stillHappening  StillHappening
  pricePaid       PricePaid?
  scheduleCorrect Boolean?
  correctedTime   String?        @db.VarChar(100)
  uploadId        String?
  photoUrl        String?        @db.VarChar(2048)
  consumedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  place  Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([placeId, personKey])
  @@unique([eventId, personKey])
  @@index([userId])
  @@index([uploadId])
}

/// Report about exactly one Place or one Event. One per person and plan (409 on a second one).
/// The reporter is stored but never shown. `resolvedAt` is set by the moderator's decision.
model Report {
  id         String       @id @default(uuid())
  placeId    String?
  eventId    String?
  userId     String?
  personKey  String       @db.VarChar(160)
  reason     ReportReason
  details    String?      @db.Text
  uploadId   String?
  photoUrl   String?      @db.VarChar(2048)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  place  Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([placeId, personKey])
  @@unique([eventId, personKey])
  @@index([resolvedAt, createdAt])
  @@index([userId])
  @@index([uploadId])
}

/// "Útil" vote: one per user and review.
model ReviewUsefulVote {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
}

/// ===============================
/// NOTIFICATIONS
/// ===============================

model Device {
  id        String   @id @default(uuid())
  userId    String
  platform  Platform
  pushToken String   @unique @db.VarChar(512)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id      String   @id @default(uuid())
  userId  String
  eventId String
  sentAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // never notify the same event twice
}
