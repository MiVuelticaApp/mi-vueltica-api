# Application
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL="mysql://tributocr:changeme@db:3306/tributocr"


# Add your other environment variables here
# JWT_SECRET=your-secret-key
# GOOGLE_MAPS_API_KEY=your-api-key
# APPLE_CLIENT_ID=com.example.yourapp
# etc.

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=no-reply@tributocr.com

# Google Sign In: client ids de Google Cloud Console (APIs y servicios > Credenciales) cuyos id tokens
# se aceptan. Opcionales para arrancar, pero sin ninguno se rechaza todo login con Google.
# En Android el token trae como audiencia el client id WEB (la app configura `webClientId`), así
# que GOOGLE_WEB_CLIENT_ID es necesario para que funcione el login en Android.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Apple Sign In (opcional; requerido para verificar id tokens de Apple en login y para
# revocar tokens en DELETE /api/v1/me — App Review 5.1.1(v)). Sin estas variables la API
# sigue arrancando; AppleOAuthProvider.revokeToken se omite silenciosamente.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Generar la clave p8 en Apple Developer > Certificates, Identifiers & Profiles > Keys.
# Pegar el PEM completo aquí (incluyendo -----BEGIN PRIVATE KEY-----).
APPLE_PRIVATE_KEY=

# Login de prueba para la revisión de App Store / Google Play.
# Permite entrar con usuario y contraseña sin pasar por Google/Apple.
# ⚠️ APAGAR (o borrar) EN CUANTO LA APP QUEDE APROBADA.
# Con TEST_LOGIN_ENABLED distinto de "true" la ruta ni siquiera se monta.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_EMAIL=review@tributocr.com
# Generar con: openssl rand -base64 24 (mínimo 16 caracteres, se valida al arrancar)
TEST_LOGIN_PASSWORD=

# Versión mínima del frontend/app soportada por esta API (semver, ej. "1.2.0").
# Obligatoria y validada al arrancar. Se expone en GET /api/v1/system/min-frontend-version.
MIN_FRONTEND_VERSION=1.2.0

# URL pública de esta API (esquema + host, sin "/" final). Las fotos subidas se sirven en
# ${PUBLIC_API_URL}/api/v1/files/:id y esa URL absoluta se guarda en las galerías.
# Obligatoria en producción; fuera de producción por defecto es http://localhost:${PORT}.
PUBLIC_API_URL=https://api.example.com

# Almacenamiento de fotos: SeaweedFS (API S3). Obligatorio: la API no arranca sin
# S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY. El bucket es privado; la API es el único cliente y
# hace de proxy de los archivos. docker-compose usa las mismas credenciales para configurar SeaweedFS.
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=mivueltica
# Generar con: openssl rand -base64 24 (sin comillas ni barras invertidas: se escribe en JSON)
S3_SECRET_KEY=changeme-s3
S3_BUCKET=mi-vueltica
# S3_REGION=us-east-1
# Direcciones estilo ruta (endpoint/bucket/clave), necesarias para SeaweedFS.
# S3_FORCE_PATH_STYLE=true
# Horas que se conserva una subida que nada referencia antes de borrarla (por defecto 24).
# UPLOAD_ORPHAN_GRACE_HOURS=24
